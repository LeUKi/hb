{
  "name": "hb",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22.20.0",
    "bun": ">=1.3.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run contracts:build && bun run --filter @hb/web dev",
    "dev:full-app": "node scripts/full-app-local-experience.mjs",
    "build": "bun run contracts:build && bun run cf:typegen && bun run --filter @hb/api typecheck && bun run --filter @hb/api build && bun run --filter @hb/web build",
    "typecheck": "bun run contracts:build && bun run cf:typegen && bun run --filter @hb/api typecheck && bun run --filter @hb/web typecheck && tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run contracts:build && bun run cf:typegen && bun run test:tooling && bun run --filter @hb/contracts test && bun run --filter @hb/api test",
    "test:e2e": "playwright test",
    "test:e2e:full-app": "playwright test --config playwright.full-app.config.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e && bun run test:e2e:full-app",
    "cf:typegen": "bun run --filter '*' cf:typegen",
    "db:generate": "bun run --filter @hb/api db:generate",
    "db:migrate:local": "bun run --filter @hb/api db:migrate:local",
    "dev:seed": "bun scripts/seed-simulation.ts --local",
    "contracts:build": "bun run --filter @hb/contracts build",
    "payment:acceptance:plan": "bun scripts/payment-acceptance.ts --plan",
    "payment:acceptance:check": "bun scripts/payment-acceptance.ts --check-local",
    "payment:recovery:plan": "bun scripts/payment-recovery.ts --plan",
    "payment:recovery:check": "bun scripts/payment-recovery.ts --check-local",
    "payment:diagnostics": "bun scripts/payment-diagnostics.ts",
    "payment:backup": "bun scripts/payment-backup.ts --local-rehearsal",
    "test:tooling": "vitest run --config scripts/vitest.config.mts",
    "release:build": "bun scripts/release.ts build",
    "release:verify": "bun scripts/release.ts verify",
    "release:deploy": "bun scripts/release.ts deploy",
    "release:migrations": "bun scripts/release.ts migrations",
    "deployment:probe": "bun scripts/deployment-probe.ts",
    "platform:controls": "bun scripts/platform-controls.ts",
    "payment:backup:remote": "bun scripts/payment-backup.ts --remote-export",
    "payment:restore:staging": "bun scripts/payment-backup.ts --remote-rehearsal --env staging"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
