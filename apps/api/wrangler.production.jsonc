{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-api-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://hb.lafi.sh",
    "APP_ENV": "production",
    "LDC_NETWORK_MODE": "live",
    "LDC_ACCEPTANCE_ID": "",
    "ADMIN_LINUX_DO_IDS": "332940",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFZAtU_ipLBom3lC",
    "LDC_STOP_NEW_OPENINGS": "false",
    "LDC_STOP_NEW_CLAIMS": "false",
    "LDC_STOP_SENDS": "false",
    "MAINTENANCE_MODE": "false",
    "DO_LOCATION_HINT": "apac",
    "DO_NAME_PREFIX": "apac:",
    "LDC_TIMED_DRAW_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hb-production-apac",
      "database_id": "c4603fec-188e-4021-bb07-9ff97a49b249",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVITY_DO",
        "class_name": "ActivityDO"
      },
      {
        "name": "MERCHANT_DO",
        "class_name": "MerchantDO"
      }
    ]
  },
  "exports": {
    "ActivityDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MerchantDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "queues": {
    "producers": [
      {
        "binding": "PAYMENT_QUEUE",
        "queue": "hb-payments-production"
      }
    ],
    "consumers": [
      {
        "queue": "hb-payments-production",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "hb-payments-production-dlq"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "OPEN_API_READS",
      "namespace_id": "1201",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "account_id": "fd9563d3d06aeeca5665fcdec5efbb80"
}
