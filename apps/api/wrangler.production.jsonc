{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-api-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://meme.442224.xyz",
    "APP_ENV": "production",
    "LDC_NETWORK_MODE": "live",
    "LDC_ACCEPTANCE_ID": "",
    "CLAIM_ATTEMPTS_PER_MINUTE": "10",
    "GLOBAL_REDEMPTIONS_PER_MINUTE": "10",
    "LDC_STOP_NEW_OPENINGS": "false",
    "LDC_STOP_NEW_CLAIMS": "false",
    "LDC_STOP_SENDS": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hb-production",
      "database_id": "ca852ed4-57c8-49bc-84ca-0ffa4e0c91c6",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVITY_DO",
        "class_name": "ActivityDO"
      },
      {
        "name": "MERCHANT_DO",
        "class_name": "MerchantDO"
      }
    ]
  },
  "exports": {
    "ActivityDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MerchantDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "PAYMENT_QUEUE",
        "queue": "hb-payments-production"
      }
    ],
    "consumers": [
      {
        "queue": "hb-payments-production",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "hb-payments-production-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "account_id": "fd9563d3d06aeeca5665fcdec5efbb80"
}
