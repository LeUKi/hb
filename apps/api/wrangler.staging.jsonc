{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://staging.hb.lafi.sh",
    "APP_ENV": "staging",
    "LDC_NETWORK_MODE": "disabled",
    "LDC_ACCEPTANCE_ID": "",
    "ADMIN_LINUX_DO_IDS": "332940",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "LDC_STOP_NEW_OPENINGS": "true",
    "LDC_STOP_NEW_CLAIMS": "true",
    "LDC_STOP_SENDS": "true",
    "MAINTENANCE_MODE": "false",
    "DO_LOCATION_HINT": "apac",
    "DO_NAME_PREFIX": "apac:",
    "LDC_TIMED_DRAW_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hb-staging-apac",
      "database_id": "20bb686f-9bc8-4990-be54-18097c992df5",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVITY_DO",
        "class_name": "ActivityDO"
      },
      {
        "name": "MERCHANT_DO",
        "class_name": "MerchantDO"
      }
    ]
  },
  "exports": {
    "ActivityDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MerchantDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "PAYMENT_QUEUE",
        "queue": "hb-payments-staging"
      }
    ],
    "consumers": [
      {
        "queue": "hb-payments-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "hb-payments-staging-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "account_id": "fd9563d3d06aeeca5665fcdec5efbb80"
}
