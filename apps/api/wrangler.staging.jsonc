{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://staging.hb.lafi.sh",
    "APP_ENV": "staging",
    "LDC_NETWORK_MODE": "disabled",
    "LDC_ACCEPTANCE_ID": "",
    "ADMIN_LINUX_DO_IDS": "332940",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "CAP_ORIGIN": "https://staging.cap.lafi.sh",
    "CAP_SITE_KEY": "hb-staging",
    "LDC_STOP_NEW_OPENINGS": "true",
    "LDC_STOP_NEW_CLAIMS": "true",
    "LDC_STOP_SENDS": "true",
    "MAINTENANCE_MODE": "false",
    "DO_LOCATION_HINT": "apac",
    "DO_NAME_PREFIX": "apac:",
    "MINI_APP_ID": "01a19ba5-b9d2-766f-9fb9-b7eddc10e0c7",
    "MINI_APP_CHANNEL": "sandbox",
    "MINI_APP_PUBLIC_KEY": "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"use\":\"sig\",\"alg\":\"ES256\",\"kid\":\"217dfe8a1dd6eaa1047673483e345d6808c171af4f66a6da98c580f36c003a88\",\"x\":\"pbVvvJPTHPqaWFO_BfVQU9ZsJ1cR-MNQfVQyGFgwyOI\",\"y\":\"T2EVZVbVR4xjnxZUxCFAYkj1yTQI5LruEs8umXxrwf4\"}]}",
    "LDC_TIMED_DRAW_ENABLED": "false",
    "STAGE_SIMULATED_PAYMENTS": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hb-staging-apac",
      "database_id": "20bb686f-9bc8-4990-be54-18097c992df5",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVITY_DO",
        "class_name": "ActivityDO"
      },
      {
        "name": "MERCHANT_DO",
        "class_name": "MerchantDO"
      }
    ]
  },
  "exports": {
    "ActivityDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MerchantDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "queues": {
    "producers": [
      {
        "binding": "PAYMENT_QUEUE",
        "queue": "hb-payments-staging"
      }
    ],
    "consumers": [
      {
        "queue": "hb-payments-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "hb-payments-staging-dlq"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "OPEN_API_READS",
      "namespace_id": "1101",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "JUDGE_FILLS",
      "namespace_id": "1102",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "services": [{ "binding": "CAP", "service": "hb-cap-staging" }],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "account_id": "fd9563d3d06aeeca5665fcdec5efbb80"
}
