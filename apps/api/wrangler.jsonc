{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hb-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVITY_DO",
        "class_name": "ActivityDO"
      },
      {
        "name": "MERCHANT_DO",
        "class_name": "MerchantDO"
      }
    ]
  },
  "exports": {
    "ActivityDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MerchantDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "queues": {
    "producers": [
      {
        "binding": "PAYMENT_QUEUE",
        "queue": "hb-local-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "hb-local-tasks",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "ratelimits": [
    {
      "name": "OPEN_API_READS",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "LDC_TIMED_DRAW_ENABLED": "true"
  }
}
