{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["../web/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../web/src/lib/corner-shape.d.ts",
    "../web/src/lib/route-data.d.ts"
  ]
}
