{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-web-production",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "meme.442224.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/production/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "services": [
    {
      "binding": "API",
      "service": "hb-api-production"
    }
  ],
  "account_id": "fd9563d3d06aeeca5665fcdec5efbb80"
}
