{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/sdk/*",
      "!/version.json",
      "!/og.png",
      "!/src/*",
      "!/@*",
      "!/node_modules/*"
    ]
  },
  "services": [
    {
      "binding": "API",
      "service": "hb-api"
    }
  ]
}
