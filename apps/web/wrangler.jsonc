{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/%F0%9F%A7%A7/*/%F0%9F%96%BC*",
      "/%f0%9f%a7%a7/*/%f0%9f%96%bc*"
    ]
  },
  "services": [
    {
      "binding": "API",
      "service": "hb-api"
    }
  ]
}
