{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-cap-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cap.lafi.sh", "custom_domain": true }],
  "vars": {
    "CAP_SITES": "[{\"key\":\"hb\",\"name\":\"红包站\",\"secretHash\":\"81345faf30b2df58070213982881c89c2d59ff9e881799e3412a56a32e752c08\",\"origins\":[\"https://hb.lafi.sh\"],\"challengeCount\":100,\"difficulty\":4,\"instrumentation\":true}]",
    "DO_LOCATION_HINT": "apac"
  },
  "durable_objects": {
    "bindings": [{ "name": "CAP_STORE", "class_name": "CapStore" }]
  },
  "exports": {
    "CapStore": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [
    {
      "name": "PUBLIC_LIMIT",
      "namespace_id": "2201",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "alias": {
    "esbuild": "./src/absent.ts",
    "javascript-obfuscator": "./src/absent.ts"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "account_id": "fd9563d3d06aeeca5665fcdec5efbb80"
}
