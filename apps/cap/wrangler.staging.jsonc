{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hb-cap-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "staging.cap.lafi.sh", "custom_domain": true }],
  "vars": {
    "CAP_SITES": "[{\"key\":\"hb-staging\",\"name\":\"红包站（Stage）\",\"secretHash\":\"019e8f3fbe90aac1c9171b5de5a2b5cb21a34543738636efa958c236a1383fb4\",\"origins\":[\"https://staging.hb.lafi.sh\"],\"challengeCount\":100,\"difficulty\":4,\"instrumentation\":true}]",
    "DO_LOCATION_HINT": "apac"
  },
  "durable_objects": {
    "bindings": [{ "name": "CAP_STORE", "class_name": "CapStore" }]
  },
  "exports": {
    "CapStore": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [
    {
      "name": "PUBLIC_LIMIT",
      "namespace_id": "2101",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "alias": {
    "esbuild": "./src/absent.ts",
    "javascript-obfuscator": "./src/absent.ts"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "account_id": "fd9563d3d06aeeca5665fcdec5efbb80"
}
