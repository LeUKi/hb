{
  "$schema": "./tests.schema.json",
  "tests": [
    {
      "name": "第一个猜中",
      "input": "flag{n0t_s0_s1mpl3}",
      "expect": { "settled": 2000, "message": "第 1 个猜中！" }
    },
    {
      "name": "猜错，还能猜 2 次",
      "input": "flag{guess}",
      "expect": {
        "pending": 0,
        "settled": null,
        "message": "不对，还能猜 2 次"
      }
    },
    {
      "name": "第三次也猜错，结算了，没领到",
      "input": "flag{guess}",
      "user": { "attempts": 2 },
      "expect": { "settled": 0, "message": "不对，次数用完了" }
    },
    {
      "name": "猜满 3 次以后猜中也不发",
      "input": "flag{n0t_s0_s1mpl3}",
      "user": { "attempts": 3 },
      "expect": { "settled": null, "messageIncludes": "不能再猜" }
    },
    {
      "name": "第 4 个猜中，拼手气",
      "input": "flag{n0t_s0_s1mpl3}",
      "claims": 3,
      "expect": { "settled": 2384, "message": "猜中了，拼手气" }
    },
    {
      "name": "奖池只剩一点：加满就结束",
      "input": "flag{n0t_s0_s1mpl3}",
      "hongbao": { "total": 5000 },
      "claims": [
        {
          "user": { "id": 20001, "username": "小王" },
          "amount": 2000,
          "input": "flag{n0t_s0_s1mpl3}",
          "at": "2026-10-24T11:30:00+08:00"
        },
        {
          "user": { "id": 20002, "username": "小李" },
          "amount": 2000,
          "input": "flag{n0t_s0_s1mpl3}",
          "at": "2026-10-24T11:40:00+08:00"
        }
      ],
      "expect": { "add": 2000, "settled": 1000, "end": true }
    },
    {
      "name": "几个人依次猜",
      "steps": [
        {
          "who": "小明",
          "input": "flag{guess}",
          "expect": { "settled": null, "message": "不对，还能猜 2 次" }
        },
        {
          "who": "小明",
          "input": "flag{n0t_s0_s1mpl3}",
          "expect": { "settled": 2000, "message": "第 1 个猜中！" }
        },
        {
          "who": "小红",
          "input": "flag{n0t_s0_s1mpl3}",
          "level": 1,
          "expect": { "settled": 2000, "message": "第 2 个猜中！" }
        },
        {
          "who": "小刚",
          "input": "flag{1}",
          "expect": { "settled": null, "message": "不对，还能猜 2 次" }
        },
        {
          "who": "小刚",
          "input": "flag{2}",
          "expect": { "settled": null, "message": "不对，还能猜 1 次" }
        },
        {
          "who": "小刚",
          "input": "flag{3}",
          "expect": { "settled": 0, "message": "不对，次数用完了" }
        }
      ]
    }
  ]
}
