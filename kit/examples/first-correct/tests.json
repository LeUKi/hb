{
  "$schema": "../../tests.schema.json",
  "params": {
    "answer": "Hello World",
    "first": 2,
    "firstAmount": 2000,
    "tries": 3
  },
  "tests": [
    {
      "name": "第一个答对，大小写不算",
      "input": "hello world",
      "expect": { "ok": true, "amount": 2000, "message": "第 1 个答对！" }
    },
    {
      "name": "答错，还能答 2 次",
      "input": "hi",
      "expect": { "ok": false, "message": "不对，还能答 2 次" }
    },
    {
      "name": "前两个以后拼手气",
      "input": "Hello World",
      "claims": 2,
      "expect": { "ok": true, "message": "答对了，拼手气" }
    },
    {
      "name": "答满了",
      "input": "Hello World",
      "user": { "attempts": 3 },
      "expect": { "ok": false, "messageIncludes": "不能再答" }
    }
  ]
}
