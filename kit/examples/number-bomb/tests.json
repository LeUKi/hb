        "viewIncludes": {
          "summary": "第 2 颗炸弹 · 安全区间 1–100"
        },
        "announce": "@tester 踩中了炸弹，领到一份，第 2 颗已经埋好",
        "end": false,
        "settle": true
      }
    },
    {
      "name": "最后一颗：不再埋，奖池分完，红包结束",
      "input": "42",
      "hongbao": {
        "total": 1000
      },
      "claims": 2,
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 40,
        "high": 45,
        "guessed": [39, 46],
        "round": 3,
        "bombs": 3
      },
      "expect": {
        "message": "踩中了最后一颗炸弹！",
        "viewIncludes": {
          "summary": "第 3 颗炸弹被踩中，红包领完了"
        },
        "announce": "@tester 踩中了最后一颗炸弹",
        "settled": 800,
        "end": true
      },
      "params": {
        "max": 100,
        "bombs": 3
      }
    },
    {
      "name": "区间外",
      "input": "70",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 1,
        "high": 49,
        "guessed": [50],
        "round": 1,
        "bombs": 5
      },
      "expect": {
        "message": "请猜 1 到 49 之间的整数",
        "announce": "",
        "settled": null
      }
    },
    {
      "name": "不是整数",
      "input": "五十",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 1,
        "high": 100,
        "guessed": [],
        "round": 1,
        "bombs": 5
      },
      "expect": {
        "message": "请猜 1 到 100 之间的整数",
        "settled": null
