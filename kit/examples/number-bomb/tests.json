{
  "$schema": "../../tests.schema.json",
  "params": { "max": 100 },
  "tests": [
    {
      "name": "安全，区间变小，写一条动态",
      "input": "50",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 1,
        "high": 100,
        "guessed": [],
        "round": 1
      },
      "expect": {
        "ok": false,
        "message": "安全！炸弹在 1–49 之间",
        "stateIncludes": { "low": 1, "high": 49, "guessed": [50] },
        "view": {
          "summary": "第 1 颗炸弹 · 安全区间 1–49",
          "data": {
            "max": 100,
            "low": 1,
            "high": 49,
            "guessed": [50],
            "round": 1
          }
        },
        "announce": "@tester 猜了 50，安全"
      }
    },
    {
      "name": "踩中：领一份，埋下第 2 颗，区间重来",
      "input": "42",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 30,
        "high": 49,
        "guessed": [29, 50],
        "round": 1
      },
      "expect": {
        "ok": true,
        "message": "踩中了炸弹！",
        "stateIncludes": { "low": 1, "high": 100, "guessed": [], "round": 2 },
        "viewIncludes": { "summary": "第 2 颗炸弹 · 安全区间 1–100" },
        "announce": "@tester 踩中了炸弹，领到一份，第 2 颗已经埋好",
        "end": false
      }
    },
    {
      "name": "最后一份：不再埋",
      "input": "42",
      "hongbao": { "total": 1000, "count": 3 },
      "claims": 2,
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 40,
        "high": 45,
        "guessed": [39, 46],
        "round": 3
      },
      "expect": {
        "ok": true,
        "message": "踩中了最后一颗炸弹！",
        "viewIncludes": { "summary": "第 3 颗炸弹被踩中，红包领完了" },
        "announce": "@tester 踩中了最后一颗炸弹"
      }
    },
    {
      "name": "区间外",
      "input": "70",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 1,
        "high": 49,
        "guessed": [50],
        "round": 1
      },
      "expect": {
        "ok": false,
        "message": "请猜 1 到 49 之间的整数",
        "announce": ""
      }
    },
    {
      "name": "不是整数",
      "input": "五十",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 1,
        "high": 100,
        "guessed": [],
        "round": 1
      },
      "expect": { "ok": false, "message": "请猜 1 到 100 之间的整数" }
    },
    {
      "name": "几个人轮流猜，区间一步步收窄，最后有人踩中",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 1,
        "high": 100,
        "guessed": [],
        "round": 1
      },
      "steps": [
        {
          "who": "小明",
          "input": "50",
          "expect": { "ok": false, "message": "安全！炸弹在 1–49 之间" }
        },
        {
          "who": "小红",
          "input": "30",
          "expect": { "ok": false, "message": "安全！炸弹在 31–49 之间" }
        },
        {
          "who": "小明",
          "input": "42",
          "expect": {
            "ok": true,
            "announce": "@小明 踩中了炸弹，领到一份，第 2 颗已经埋好"
          }
        }
      ]
    }
  ]
}
