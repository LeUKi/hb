            "max": 100,
            "low": 1,
            "high": 49,
            "guessed": [50],
            "round": 1,
            "bombs": 5
          }
        },
        "announce": "@tester 猜了 50，安全",
        "settled": null
      }
    },
    {
      "name": "踩中：领一份，埋下第 2 颗，区间重来",
      "input": "42",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 30,
        "high": 49,
        "guessed": [29, 50],
        "round": 1,
        "bombs": 5
      },
      "expect": {
        "message": "踩中了炸弹！",
        "stateIncludes": {
          "low": 1,
          "high": 100,
          "guessed": [],
          "round": 2
