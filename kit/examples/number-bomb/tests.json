{
  "$schema": "../../tests.schema.json",
  "params": {
    "max": 100
  },
  "tests": [
    {
      "name": "安全，区间变小，写一条动态",
      "input": "50",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 1,
        "high": 100,
        "guessed": [],
