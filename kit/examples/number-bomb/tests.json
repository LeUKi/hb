    },
    {
      "name": "几个人轮流猜，区间一步步收窄，最后有人踩中",
      "state": {
        "max": 100,
        "bomb": 42,
        "low": 1,
        "high": 100,
        "guessed": [],
        "round": 1,
        "bombs": 5
      },
      "steps": [
        {
          "who": "小明",
          "input": "50",
          "expect": {
            "message": "安全！炸弹在 1–49 之间",
            "settled": null
